<?xml version="1.0"?>
<robot name="paquito">
  <!-- Materiales -->
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="gray">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>
  <material name="green">
    <color rgba="0 1 0 1"/>
  </material>
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  <material name="yellow">
    <color rgba="1 1 0 1"/>
  </material>

  <link name="base_link">
      <visual>
        <geometry>
          <box size="0.8 0.1 0.7"/>
        </geometry>
        <origin rpy="1.57075 0 0" xyz="0 0 0.1"/>
        <material name="black"/>
      </visual>
  </link>

  <link name="left_front_wheel">
    <visual>
      <origin rpy="1.57075 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.12"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="left_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin rpy="0 0 0" xyz="0.2 0.35 0.1"/>
  </joint>

  <link name="right_front_wheel">
    <visual>
      <origin rpy="1.57075 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.12"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="right_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin rpy="0 0 0" xyz="0.2 -0.35 0.1"/>
  </joint>

  <link name="left_rear_wheel">
    <visual>
      <origin rpy="1.57075 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.12"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>

  <joint name="left_rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin rpy="0 0 0" xyz="-0.2 0.35 0.1"/>
  </joint>

  <link name="right_rear_wheel">
    <visual>
      <origin rpy="1.57075 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.12"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="right_rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin rpy="0 0 0" xyz="-0.2 -0.35 0.1"/>
  </joint>


</robot>